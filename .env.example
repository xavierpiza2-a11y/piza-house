# ====================================================================
# Configuration de l'environnement Piza-House
# Copiez ce fichier vers .env pour personnaliser votre déploiement
# ====================================================================

# Port d'écoute du serveur HTTP / WebSocket (défaut : 3000 en dev, 2601 en production)
PORT=3000

# Mode d'exécution ('development' ou 'production')
NODE_ENV=development

# Répertoire de stockage des données persistantes (utilisateurs, scores, salons, etc.)
# Par défaut : ./data
DATA_DIR=./data

# Clé API Anthropic (Claude) pour la génération automatique des quiz par IA et les répliques de Xav
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# Adresse email unique autorisée à accéder au panneau d'administration
# Renseignée avant le build / démarrage : seul ce compte possèdera les privilèges administrateur
ADMIN_EMAIL=xavier.piza2@gmail.com
VITE_ADMIN_EMAIL=xavier.piza2@gmail.com
